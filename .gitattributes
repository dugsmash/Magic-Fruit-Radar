# Normalize line endings across platforms
* text=auto

# Scripts & Gradle files: always LF
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.kts text eol=lf
gradlew text eol=lf
*.sh text eol=lf

# Windows batch stays CRLF
*.bat text eol=crlf

# Binary assets: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jks binary
*.apk binary
