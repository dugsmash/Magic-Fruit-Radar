<?xml version="1.0" encoding="utf-8"?>
<!--
  数据提取规则（Android 12+ / API 31+）：
  全部域（root/file/database/sharedpref/external）在云备份与设备迁移中都排除——
  配合 android:allowBackup="false"，保证卸载应用后，API Key、许愿单、
  记录等设置不会残留在系统备份/迁移数据中（隐私优先：卸载即彻底清除）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
