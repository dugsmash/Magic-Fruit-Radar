<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:padding="12dp" android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/recDate" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/ink" />
        <TextView android:id="@+id/recCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/purple"
            android:background="@drawable/bg_status"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" />
    </LinearLayout>
    <TextView android:id="@+id/recRound" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#000000"
        android:layout_marginTop="3dp" />
    <TextView android:id="@+id/recItems" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#000000"
        android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
</LinearLayout>
